# Server Configuration
PORT=5000
NODE_ENV=development
JWT_SECRET=your_super_secret_jwt_key_at_least_32_characters_long
CLIENT_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:3000,http://127.0.0.1:3000

# MongoDB Connection String (Atlas or local)
# Example: mongodb+srv://username:password@cluster0.mongodb.net/ai_interview?retryWrites=true&w=majority
MONGO_URI=mongodb://localhost:27017/ai_interview

# Primary AI Provider ("gemini", "groq", or "openrouter")
AI_PROVIDER_PRIMARY=gemini

# Google Gemini API
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-flash-lite-latest

# Groq API
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-20b

# OpenRouter API
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=liquid/lfm-3-1.7b:free
